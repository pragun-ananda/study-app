# ========================================================
# Database Configuration (PostgreSQL 16)
# ========================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=study_db
POSTGRES_HOST_PORT=127.0.0.1:5432

# ========================================================
# Application Ports
# ========================================================
# Port exposed on the host Mac Mini (accessible via localhost, LAN, or Tailscale)
APP_PORT=3000

# ========================================================
# LLM Inference Configuration
# ========================================================
# Option 1: OpenAI (Default & Recommended)
# Provide your OpenAI API key and specify model (e.g. gpt-4o-mini or gpt-4o)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Option 2: Local Ollama on Mac Mini (Optional Zero-Cost / Offline)
# To route inference to Ollama instead of OpenAI:
# 1. Leave OPENAI_API_KEY blank
# 2. Uncomment the following lines:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=gemma4:e4b
# LLM_API_KEY=local-no-key-required

# LLM Timeout in milliseconds
LLM_TIMEOUT_MS=30000
